# Normalización de finales de línea (repositorio multiplataforma).
* text=auto eol=lf

*.md       text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.php      text eol=lf
*.dart     text eol=lf
*.arb      text eol=lf
*.sh       text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.conf     text eol=lf

# Binarios
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
*.otf      binary
*.ttf      binary
*.woff     binary
*.woff2    binary
*.wasm     binary

# Diff legible para artefactos de evidencia
spikes/**/*.json linguist-generated=true
